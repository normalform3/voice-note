# Copy this file to .env before starting locally. Spring Boot loads .env automatically.
# Process environment variables take precedence over values in .env.
# Use SSH tunnels for these local ports during development. Never commit real values.
VOICENOTE_DB_URL=jdbc:mysql://127.0.0.1:3306/voicenote?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
VOICENOTE_DB_USERNAME=voicenote
VOICENOTE_DB_PASSWORD=replace-me
VOICENOTE_MINIO_ENDPOINT=http://127.0.0.1:9000
VOICENOTE_MINIO_ACCESS_KEY=replace-me
VOICENOTE_MINIO_SECRET_KEY=replace-me
VOICENOTE_MINIO_BUCKET=voicenote
VOICENOTE_ROCKETMQ_NAMESRV=127.0.0.1:9876
ROCKETMQ_ENABLED=false
# Set DASHSCOPE_ENABLED=true and provide DASHSCOPE_API_KEY to enable ASR, Agent chat, and embeddings.
DASHSCOPE_ENABLED=false
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_ASR_MODEL=paraformer-v2
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSION=1024
VOICENOTE_KNOWLEDGE_ENABLED=false
VOICENOTE_QDRANT_URL=http://127.0.0.1:6333
VOICENOTE_QDRANT_COLLECTION=voicenote_knowledge
VOICENOTE_KNOWLEDGE_CHUNK_TARGET_TOKENS=800
VOICENOTE_KNOWLEDGE_CHUNK_MAX_TOKENS=1200
VOICENOTE_JWT_SECRET=replace-with-at-least-32-random-characters
