# Copy to .tunnel.env. Do not commit the copied file.
# SSH_TUNNEL_TARGET=developer@your-server
# SSH_PORT=22
# SSH_IDENTITY_FILE=/absolute/path/to/your/private-key

# Override a value only when the service uses a non-default port or host on the server.
# MYSQL_LOCAL_PORT=3306
# MYSQL_REMOTE_HOST=127.0.0.1
# MYSQL_REMOTE_PORT=3306
# REDIS_LOCAL_PORT=6379
# REDIS_REMOTE_HOST=127.0.0.1
# REDIS_REMOTE_PORT=6379
# MINIO_LOCAL_PORT=9000
# MINIO_REMOTE_HOST=127.0.0.1
# MINIO_REMOTE_PORT=9000
# ROCKETMQ_NAMESRV_LOCAL_PORT=9876
# ROCKETMQ_NAMESRV_REMOTE_HOST=127.0.0.1
# ROCKETMQ_NAMESRV_REMOTE_PORT=9876
# ROCKETMQ_BROKER_LOCAL_PORT=10911
# ROCKETMQ_BROKER_REMOTE_HOST=127.0.0.1
# ROCKETMQ_BROKER_REMOTE_PORT=10911
